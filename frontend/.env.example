# Base URL for the backend API. Leave as /api to use the Vite dev-server proxy in vite.config.js.
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws

# Absolute origin of the backend. Used only for full-page navigations that can't go
# through the Vite proxy above (currently: the "Continue with Google" link).
VITE_BACKEND_URL=http://localhost:8080
